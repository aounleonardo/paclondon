# =============================================================================
# Local upload scripts ONLY (never commit real values)
# Used by: precompute:islington:upload, upload:vacant-houses
# =============================================================================

# Project configuration → General → Project information → Project ID
NETLIFY_SITE_ID=

# https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=

# Optional overrides for upload scripts / functions
# NETLIFY_BLOBS_STORE=mazes
# NETLIFY_BLOBS_REGION=us-east-2
# DEFAULT_BOROUGH_ID=islington

# =============================================================================
# Netlify UI site env vars (Project → Environment variables)
# =============================================================================
#
# For the LIVE app reading blobs via Netlify Functions:
#   → NONE required.
#   Functions get siteID/token automatically. Store defaults to "mazes".
#
# Optional site env vars:
#   NETLIFY_BLOBS_STORE=mazes
#   DEFAULT_BOROUGH_ID=islington
#
# Optional Vite build-time vars:
#   VITE_DEFAULT_BOROUGH_ID=islington
#   VITE_MAZE_URL=/api/borough/islington/maze
#   VITE_VACANT_HOUSES_URL=/api/borough/islington/vacant-houses
#
# Blob keys:
#   islington/maze
#   islington/vacant-houses
